# Optional compatibility input for an existing SQL volume; a clean checkout
# starts with docker compose up --build and needs no .env or host Python.
# Keep your original .env on first upgrade to adopt the existing passwords.
# For manually prepared local values use python scripts/configure_local.py.
# Never commit .env.
# The generated values use Aa1 followed by random hex, safe for SQL and URL use.
MSSQL_SA_PASSWORD=
RESTAURANTS_PASSWORD=
DINING_PASSWORD=
