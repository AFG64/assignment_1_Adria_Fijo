{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Picky system description (student-authored)",
  "description": "Student-authored from Assignment 2 \u00a78a; not official or professor-provided. Closed objects, exactly two services, port range and secret/default alternatives are local interpretations. Local placeholders are permitted; validation is not deployment readiness or equivalence to an unknown official schema.",
  "type": "object",
  "properties": {
    "student": {
      "type": "string",
      "minLength": 1
    },
    "prefix": {
      "type": "string",
      "minLength": 1
    },
    "public_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "ui": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
        },
        "static_web_app": {
          "type": "string",
          "minLength": 1
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "static_web_app",
        "calls"
      ],
      "additionalProperties": false
    },
    "azure": {
      "type": "object",
      "properties": {
        "resource_group": {
          "type": "string",
          "minLength": 1
        },
        "container_apps_environment": {
          "type": "string",
          "minLength": 1
        },
        "sql_server": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "resource_group",
        "container_apps_environment",
        "sql_server",
        "registry"
      ],
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "required": [
    "student",
    "prefix",
    "public_url",
    "ui",
    "azure",
    "services"
  ],
  "additionalProperties": false,
  "$defs": {
    "environment": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "secret": {
              "const": true
            }
          },
          "required": [
            "description",
            "secret"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "default": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "secret": {
              "const": false
            }
          },
          "required": [
            "description",
            "default"
          ],
          "additionalProperties": false
        }
      ]
    },
    "call": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "url_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /\\S*$"
          }
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "on_failure": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "service",
        "url_env",
        "endpoints",
        "timeout_s",
        "on_failure"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
        },
        "openapi": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
        },
        "port_default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health": {
          "const": "/health"
        },
        "migrations": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
        },
        "env": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/environment"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "azure": {
          "type": "object",
          "properties": {
            "container_app": {
              "type": "string",
              "minLength": 1
            },
            "sql_database": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "container_app",
            "sql_database"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "description",
        "path",
        "openapi",
        "port_default",
        "health",
        "migrations",
        "env",
        "calls",
        "azure"
      ],
      "additionalProperties": false
    }
  }
}
